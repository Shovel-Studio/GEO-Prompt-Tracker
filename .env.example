# Copy to .env and fill in. Only the analysis API key is required.

# Analysis LLM — extracts the ranked recommendations from each scraped answer.
# Set ONE of these and point ANALYSIS_PROVIDER at it.
ANALYSIS_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model used for scoring (cheap is fine).
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: where results are saved. Defaults to
# ~/Library/Application Support/GEO Tool (kept off iCloud / the project folder).
# GEO_DATA_DIR=
